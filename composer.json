{
    "name": "letsdeploy/statamic-reviews",
    "description": "Google reviews for Statamic",
    "type": "statamic-addon",
    "authors": [
        {
            "name": "letsdeploy",
            "email": "sem@letsdeploy.nl",
            "homepage": "https://letsdeploy.nl"
        }
    ],
    "autoload": {
        "psr-4": {
            "Letsdeploy\\Reviews\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Letsdeploy\\Reviews\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.5",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Google Reviews",
            "description": "Google reviews for Statamic",
            "developer": "letsdeploy",
            "developer-url": "https://letsdeploy.nl"
        },
        "laravel": {
            "providers": [
                "Letsdeploy\\Reviews\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
